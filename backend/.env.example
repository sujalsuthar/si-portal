# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Database (Postgres)
DATABASE_URL=postgresql://samp_user:samp_password@localhost:5432/samp_db?schema=public

# Auth
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Keyed hash secret for receipt integrity verification codes (defaults to JWT_ACCESS_SECRET if unset)
RECEIPT_HMAC_SECRET=change-this-receipt-hmac-secret-in-production

# Backups are AES-256-GCM encrypted at rest (defaults to JWT_ACCESS_SECRET if unset)
BACKUP_ENCRYPTION_KEY=change-this-backup-encryption-key-in-production
BACKUP_OFFSITE_DIR=
BACKUP_SCHEDULE_CRON=59 23 * * *

# Seed / bootstrap super admin
SEED_ADMIN_EMAIL=admin@siportal.edu
SEED_ADMIN_PASSWORD=ChangeMe123!

# Set to true on Render to load demo data on first start (courses, batches, students, exams, etc.)
SEED_ON_START=false

# MFA is disabled by default (mfaRequiredRoles=[]). If upgrading an existing DB without re-seeding,
# run: psql $DATABASE_URL -f scripts/demo-mfa-off.sql

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# SMTP (leave blank to disable email sending; notifications are still recorded in-app)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SI Portal <no-reply@siportal.edu>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
