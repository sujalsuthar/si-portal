# Copy this file to .env before running `docker compose up` — compose reads it automatically.

# Postgres
POSTGRES_USER=samp_user
POSTGRES_PASSWORD=samp_password
POSTGRES_DB=samp_db

# Public URLs (used for CORS and for links embedded in certificate QR codes / emails)
APP_URL=http://localhost:4000
WEB_URL=http://localhost:8080

# Auth secrets — MUST be changed to long random values before any real deployment
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Keyed hash secret for receipt integrity verification codes (defaults to JWT_ACCESS_SECRET if unset)
RECEIPT_HMAC_SECRET=change-this-receipt-hmac-secret-in-production

# Backups are AES-256-GCM encrypted at rest with this key (defaults to JWT_ACCESS_SECRET if unset)
BACKUP_ENCRYPTION_KEY=change-this-backup-encryption-key-in-production
# Optional second path (e.g. a mounted network share) backups are also copied to for offsite retention
BACKUP_OFFSITE_DIR=
# Cron expression for the automatic nightly backup; leave set for production, blank to disable
BACKUP_SCHEDULE_CRON=59 23 * * *

# Bootstrap super admin + demo dataset password (see SEED_ON_START below)
SEED_ADMIN_EMAIL=admin@siportal.edu
SEED_ADMIN_PASSWORD=ChangeMe123!

# Set to true to load a realistic demo dataset (courses, batches, students, exams, etc.)
# on first container start. Use true for demos; false for empty production.
SEED_ON_START=true

MAX_UPLOAD_MB=10

# SMTP (optional) — leave blank to disable outbound email; notifications still record in-app
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SI Portal <no-reply@siportal.edu>"
